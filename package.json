{
  "name": "kash",
  "version": "1.0.3",
  "homepage": "https://github.com/matthewhudson/kash",
  "description": "Fast and simple in-memory caching.",
  "main": "./dist/index.js",
  "module": "./dist/index.mjs",
  "browser": "./dist/index.global.js",
  "types": "./dist/index.d.ts",
  "files": [
    "dist"
  ],
  "keywords": [
    "cache",
    "caching",
    "ram",
    "memory",
    "storage"
  ],
  "author": {
    "name": "Matthew Hudson",
    "email": "matthud@gmail.com"
  },
  "repository": {
    "type": "git",
    "url": "git://github.com/matthewhudson/kash.git"
  },
  "bugs": {
    "url": "https://github.com/matthewhudson/kash/issues"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "@types/jest": "30.0.0",
    "@types/node": "25.3.2",
    "@typescript-eslint/eslint-plugin": "8.56.1",
    "@typescript-eslint/parser": "8.56.1",
    "benchmark": "2.1.4",
    "codecov": "3.8.3",
    "cz-conventional-changelog": "3.3.0",
    "eslint": "10.0.2",
    "jest": "29.5.0",
    "ts-jest": "29.4.6",
    "tsup": "8.5.1",
    "typescript": "5.9.3",
    "typescript-eslint": "8.56.1"
  },
  "scripts": {
    "build": "tsup",
    "dev": "tsup --watch",
    "lint": "eslint src",
    "lint:fix": "eslint src --fix",
    "test": "jest",
    "test:coverage": "jest --coverage && codecov"
  },
  "license": "MIT",
  "config": {
    "commitizen": {
      "path": "./node_modules/cz-conventional-changelog"
    }
  },
  "jest": {
    "preset": "ts-jest",
    "testEnvironment": "node",
    "collectCoverage": true,
    "coverageReporters": [
      "json",
      "lcov",
      "text",
      "clover"
    ],
    "transform": {
      "^.+\\.tsx?$": "ts-jest"
    }
  }
}
